<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo reference="${prefix}body">
    <sensor name="nav_cam" type="wideanglecamera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>1.0</update_rate>
      <topic>wide_angle_camera</topic>
      <camera>
        <horizontal_fov>2.957216683909311</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <!--<format>L8</format>-->	
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>20</far>
        </clip>
        <distortion>
          <k1>0.993308</k1>
        </distortion>
      </camera>
      <plugin 
        name="astrobee_plugin_nav_cam" 
        filename="gazebo_sensor_plugin_nav_cam">
      </plugin>
      <!--<plugin 
        name="astrobee_gazebo::GazeboSensorPluginSparseMap" 
        filename="gazebo_sensor_plugin_sparse_map">
      </plugin>
      <plugin 
        name="astrobee_gazebo::GazeboSensorPluginOpticalFlow" 
        filename="gazebo_sensor_plugin_optical_flow">
      </plugin>-->
    </sensor>
  </gazebo>
</robot>
